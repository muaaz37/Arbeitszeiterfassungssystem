# Copy this file to .env and set a local password before running Docker Compose.

# The application database uses this password.
POSTGRES_PASSWORD=

# Keycloak and its PostgreSQL database share the database username and password.
KEYCLOAK_DB_NAME=keycloak
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=
KC_DB=postgres

# Initial administrator for the local Keycloak Admin Console.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Application PostgreSQL database.
APP_DB_NAME=arbeitszeiterfassung
APP_DB_USER=arbeitszeiterfassung
